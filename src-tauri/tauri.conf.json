{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CAD Studio",
  "version": "0.5.0",
  "identifier": "de.hausraster.cadstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CAD Studio",
        "width": 1280,
        "height": 860,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:47321 http://localhost:47321; img-src 'self' data: blob: http://127.0.0.1:47321; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "resources": {
      "python/": "python/",
      "../sidecar/": "sidecar/",
      "../geometry/hausraster/src/": "geometry/hausraster/src/",
      "../geometry/hausraster/FreeCAD_Mod/": "geometry/hausraster/FreeCAD_Mod/",
      "../geometry/hausraster/macros/": "geometry/hausraster/macros/",
      "../geometry/hausraster/README.md": "geometry/hausraster/README.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
